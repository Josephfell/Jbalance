# Go Load Balancer — environment configuration
#
# Copy this file to .env and adjust values as needed, then run with
# `docker compose --env-file .env up`. Every setting here can also be
# passed as a CLI flag (see `-h` on either binary) — a flag always takes
# precedence over the matching environment variable if both are set.
#
# None of these are required to get started locally: every variable below
# has a working default baked into the binaries themselves. This file only
# needs to be filled in once you're deploying somewhere real.

# ── Control plane ────────────────────────────────────────────────────────

# Address the control plane's gRPC server listens on.
LB_GRPC_ADDR=:9090

# How often the control plane polls the backend pool provider for changes.
LB_RECONCILE_INTERVAL=2s

# Which backend pool provider to use: 'fake' (local testing/demo) or
# 'azure-vmss' (real Azure VM Scale Set backends). See the
# "Azure VMSS provider" section below for the azure-vmss-specific settings.
LB_PROVIDER=fake

# ── Fake provider settings (only used when LB_PROVIDER=fake) ─────────────

# Whether to randomly add/remove backends on a timer, simulating real
# scale-out/scale-in events.
LB_SIMULATE_SCALING=false

# How often the fake provider simulates a scale-out/scale-in event.
LB_SCALING_INTERVAL=5s

# Starting port number the fake provider assigns to its simulated backend
# addresses.
LB_FAKE_BASE_PORT=8081

# ── Azure VMSS provider settings (only used when LB_PROVIDER=azure-vmss) ─

# The Azure subscription and resource group containing the scale set(s).
LB_AZURE_SUBSCRIPTION_ID=
LB_AZURE_RESOURCE_GROUP=

# Comma-separated group specs mapping a control-plane group name to the
# Azure VM Scale Set that backs it and the port each instance serves
# traffic on: group:scaleSetName:port[:weight]
#
# Example: LB_AZURE_VMSS_GROUPS=web-tier:vmss-web:8080,api-tier:vmss-api:8081
LB_AZURE_VMSS_GROUPS=

# Authentication uses azidentity.DefaultAzureCredential, which tries (in
# order): environment variables (AZURE_CLIENT_ID / AZURE_CLIENT_SECRET /
# AZURE_TENANT_ID for a service principal), workload identity, managed
# identity, and Azure CLI credentials. Set whichever of these applies to
# your deployment — none of them are specific to this tool, they're
# standard Azure SDK environment variables. See:
# https://learn.microsoft.com/en-us/azure/developer/go/azure-sdk-authentication
#
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# ── Control plane TLS (recommended for anything beyond local testing) ────

# Path to a TLS certificate/key for the control plane's gRPC server. Leave
# both empty to run in plaintext (fine for local development only — do not
# do this across a real network).
LB_TLS_CERT=
LB_TLS_KEY=

# Path to a CA certificate used to require and verify data plane client
# certificates (mutual TLS). Leave empty to allow any client to connect
# once server-side TLS is enabled.
LB_TLS_CLIENT_CA=

# ── Admin web management UI ───────────────────────────────────────────────
#
# A small password-protected web dashboard showing live backend group
# state, with the ability to change the admin password from the UI. All
# state (password hash + session secret) lives in a single local JSON
# file inside the container — no external database.
#
# On first run, a random password is generated and printed ONCE to the
# container's logs (`docker logs <container>`) — look for a clearly
# marked block near startup. It is not stored in plaintext anywhere. If
# you lose it, set LB_ADMIN_FORCE_RESET_PASSWORD=true for one restart to
# generate and print a new one.

# Address the admin web UI listens on.
LB_ADMIN_ADDR=:9091

# Set to true to disable the admin web UI entirely.
LB_ADMIN_DISABLE=false

# Path to the local admin store file (password hash + session secret).
# Should point to a persistent volume if you want the password (and any
# change made via the UI) to survive a container restart — otherwise a
# new random password is generated every time the container starts.
LB_ADMIN_STORE_PATH=/var/lib/go-loadbalancer/admin.json

# Path to a TLS certificate/key for the admin web UI. Leave both empty to
# serve plain HTTP (fine for local development, or if TLS termination
# happens upstream, e.g. at a reverse proxy).
LB_ADMIN_TLS_CERT=
LB_ADMIN_TLS_KEY=

# Only enable this if the admin UI sits behind a trusted reverse proxy
# that itself sets X-Forwarded-For — otherwise a client could bypass
# login rate-limiting by setting the header themselves.
LB_ADMIN_TRUST_FORWARDED_FOR=false

# Set to true for exactly one restart to force-generate and print a new
# random admin password (e.g. if you've lost the current one), then set
# it back to false.
LB_ADMIN_FORCE_RESET_PASSWORD=false

# Path to the local admin audit log file (login attempts, password
# changes/resets, logouts, pool overrides, algorithm changes). Bounded to
# the last 500 events — this is meant for "what just happened" debugging,
# not a permanent compliance record. Mount a volume over its directory if
# you want history to survive a container restart.
LB_ADMIN_AUDIT_LOG_PATH=/var/lib/go-loadbalancer/audit.json

# Path to the local file storing manual per-backend weight/drain overrides
# set via the admin web UI's dashboard. Mount a volume over its directory
# if you want overrides to survive a container restart.
LB_ADMIN_OVERRIDES_PATH=/var/lib/go-loadbalancer/overrides.json

# Path to the local file storing per-group load-balancing algorithm
# selections (round_robin / least_connections / random) set via the admin
# web UI's dashboard. Mount a volume over its directory if you want the
# selection to survive a container restart — otherwise every group reverts
# to round_robin on the next start.
LB_ADMIN_ALGORITHMS_PATH=/var/lib/go-loadbalancer/algorithms.json

# Path to the local file storing the L7 route table (host/path/method ->
# target group rules) set via the admin web UI's Routes page. Mount a
# volume over its directory if you want routes to survive a container
# restart — otherwise every data plane instance reverts to routing
# everything to its own -group on the next start.
LB_ADMIN_ROUTES_PATH=/var/lib/go-loadbalancer/routes.json

# Path to the local file storing per-group sticky-session configuration
# (enabled/cookie name/TTL) set via the admin web UI's dashboard. Mount a
# volume over its directory if you want the configuration to survive a
# container restart — otherwise every group reverts to sticky sessions
# disabled on the next start.
LB_ADMIN_STICKY_PATH=/var/lib/go-loadbalancer/sticky.json

# ── Data plane ────────────────────────────────────────────────────────────

# Which proxy mode this data plane instance runs: 'http' (L7, supports
# routing and sticky sessions) or 'tcp' (L4, raw byte forwarding to a
# single backend group — for non-HTTP protocols, databases, TLS
# passthrough, etc). L7 routing and sticky sessions only apply in 'http'
# mode.
LB_PROTOCOL=http

# Address this data plane instance accepts incoming traffic on (HTTP or
# raw TCP, depending on LB_PROTOCOL).
LB_LISTEN_ADDR=:8080

# Address of the control plane's gRPC server this data plane connects to.
# When running via Docker Compose, this should be the control plane
# service's name and port, e.g. controlplane:9090.
LB_CONTROL_PLANE_ADDR=controlplane:9090

# Which backend group this data plane instance serves traffic for. Must
# match a group name the control plane's pool provider reports.
LB_GROUP=web-tier

# Identifier for this instance, used only for control plane logging. If
# left empty, the container/host's hostname is used — usually fine as-is.
LB_INSTANCE_ID=

# ── Data plane health checking ────────────────────────────────────────────

# How often each backend is health-checked, and the timeout per check.
LB_HEALTH_CHECK_INTERVAL=5s
LB_HEALTH_CHECK_TIMEOUT=2s

# Consecutive failed/successful checks required before a backend is taken
# out of / returned to rotation. Higher thresholds reduce flapping at the
# cost of slower reaction to real outages.
LB_UNHEALTHY_THRESHOLD=3
LB_HEALTHY_THRESHOLD=2

# How often this data plane reports its locally observed backend health
# back to the control plane, for display in the admin web UI's dashboard.
# Independent of LB_HEALTH_CHECK_INTERVAL — this is how often the *result*
# of local health checking is sent upstream, not how often backends are
# probed.
LB_HEALTH_REPORT_INTERVAL=10s

# ── Data plane metrics / monitoring ───────────────────────────────────────

# Address to serve Prometheus metrics on (GET /metrics), separate from the
# traffic listener so a scrape can never compete with (or be mistaken
# for) an actual proxied request/connection.
LB_METRICS_ADDR=:9100

# Set to true to disable the /metrics endpoint (and the push of a traffic
# summary to the control plane, used by the admin web UI's live charts)
# entirely.
LB_METRICS_DISABLE=false

# How often to push a lightweight traffic summary (requests, error rate,
# active connections, average latency, per group) to the control plane —
# independent of LB_METRICS_ADDR, which anyone can scrape directly at any
# time regardless of this interval.
LB_METRICS_REPORT_INTERVAL=10s

# ── Data plane TLS (recommended for anything beyond local testing) ───────

# Whether this data plane connects to the control plane over TLS, and
# which CA to verify the control plane's certificate against. Leave
# LB_CONTROL_PLANE_TLS_CA empty to use the system root CA pool (appropriate
# if the control plane's cert is from a public/trusted CA).
LB_CONTROL_PLANE_TLS=false
LB_CONTROL_PLANE_TLS_CA=

# Client certificate/key this data plane presents to the control plane, for
# mutual TLS. Leave both empty unless the control plane requires client
# certs (i.e. LB_TLS_CLIENT_CA is set on the control plane).
LB_CONTROL_PLANE_TLS_CLIENT_CERT=
LB_CONTROL_PLANE_TLS_CLIENT_KEY=

# Path to a TLS certificate/key for this data plane's own HTTP listener.
# Leave both empty to serve plain HTTP (fine for local development, or if
# TLS termination happens upstream of this proxy, e.g. at a cloud load
# balancer or ingress).
LB_HTTP_TLS_CERT=
LB_HTTP_TLS_KEY=
